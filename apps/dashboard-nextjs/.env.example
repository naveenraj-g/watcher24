# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Auth (shared with IAM — same DB, same secret keeps sessions consistent) ───
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-me-use-same-value-as-iam

# ── PostgreSQL (shared with IAM — auth tables are read from here) ─────────────
DATABASE_URL=postgresql://watcher:watcher_secret@localhost:5433/watcher

# ── ClickHouse (telemetry data store) ─────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=watcher
CLICKHOUSE_PASSWORD=watcher_secret
CLICKHOUSE_DB=watcher

# ── Realtime service (WebSocket endpoint) ─────────────────────────────────────
# Used by the browser-side live feed; must be reachable from the client.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081
