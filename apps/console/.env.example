# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── IAM service (auth authority) ──────────────────────────────────────────────
# Server-to-server calls (bypasses the Next.js proxy).
IAM_URL=http://localhost:5000
# Browser-accessible IAM URL used for OAuth PKCE redirects.
NEXT_PUBLIC_IAM_URL=http://localhost:5000

# ── OAuth client credentials ──────────────────────────────────────────────────
# Register a client in the IAM admin panel (/admin/oauth-clients) to get these.
# NEXT_PUBLIC_ prefix is intentional — the client_id is public (safe to expose).
NEXT_PUBLIC_CONSOLE_CLIENT_ID=
# The client_secret is server-side only. Never expose this to the browser.
CONSOLE_CLIENT_SECRET=

# ── ClickHouse (telemetry data store) ─────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=watcher
CLICKHOUSE_PASSWORD=watcher_secret
CLICKHOUSE_DB=watcher

# ── Realtime service (WebSocket endpoint) ─────────────────────────────────────
# Used by the browser-side live feed; must be reachable from the client.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081

# (IAM_DATABASE_URL removed — app/key management now goes through IAM HTTP API)
