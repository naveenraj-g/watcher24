# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── IAM service (auth authority) ──────────────────────────────────────────────
# Browser calls hit /api/auth/* which next.config.ts proxies to IAM_URL.
# Server components call IAM_URL directly (bypasses the proxy).
IAM_URL=http://localhost:5000

# ── ClickHouse (telemetry data store) ─────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=watcher
CLICKHOUSE_PASSWORD=watcher_secret
CLICKHOUSE_DB=watcher

# ── Realtime service (WebSocket endpoint) ─────────────────────────────────────
# Used by the browser-side live feed; must be reachable from the client.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081
