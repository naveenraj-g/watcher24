LOG_DIR=../logs/iam
INTERNAL_URL=http://localhost:5000

# Better Auth
BETTER_AUTH_SECRET=your_secret_here
BETTER_AUTH_URL=http://localhost:5000

# OAuth Provider client pages URL
LOGIN_PAGE=http://localhost:5000/auth/sign-in
CONSENT_PAGE=http://localhost:5000/auth/consent
SIGNUP_PAGE=http://localhost:5000/auth/sign-up
TWO_FACTOR_PAGE=http://localhost:5000/auth/two-factor

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP)
SMTP_EMAIL=
SMTP_PASS=
SMTP_FROM_NAME=Watcher24

# Database (watcher24 postgres container on port 5433, iam database)
DATABASE_URL="postgresql://watcher:watcher_secret@localhost:5433/iam"

INTERNAL_API_SECRET=your_internal_secret_here

# Stripe (billing & subscriptions)
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from https://dashboard.stripe.com/webhooks
# Register: POST /api/auth/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from https://dashboard.stripe.com/products
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_...
