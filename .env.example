# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=watcher
POSTGRES_USER=watcher
POSTGRES_PASSWORD=watcher_secret
POSTGRES_URL=postgresql://watcher:watcher_secret@localhost:5433/watcher

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=watcher
CLICKHOUSE_USER=watcher
CLICKHOUSE_PASSWORD=watcher_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=watcher
MINIO_SECRET_KEY=watcher_secret
MINIO_BUCKET=watcher-archive

# Gateway
GATEWAY_PORT=8080
GATEWAY_ENV=development

# IAM service (better-auth)
# API keys are issued by the IAM and validated here by the gateway
IAM_DATABASE_URL=postgresql://watcher:watcher_secret@localhost:5433/iam
BETTER_AUTH_SECRET=change_me_in_production
