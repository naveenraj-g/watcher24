# Browser-side (safe to expose — read-only ingest key)
# Create an app in the console (Settings → Apps), link a key to it, paste it here.
# The gateway will resolve the app automatically from the key.
NEXT_PUBLIC_W24_API_KEY=wtch_your_api_key_here
NEXT_PUBLIC_W24_GATEWAY_URL=http://localhost:8080

# Optional — only needed for legacy org-level keys that have no app linked.
# App-scoped keys (the default since multi-app support) do not need this.
# NEXT_PUBLIC_W24_APP_ID=bookmarks-client

# Server-side only (never exposed to the browser)
W24_API_KEY=wtch_your_api_key_here
W24_GATEWAY_URL=http://localhost:8080

# Optional — same as above, only for legacy org-level keys.
# W24_APP_ID=bookmarks-server
