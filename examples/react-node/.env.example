# Watcher24 API key — create an app in the console (Settings → Apps), link a key, paste it here.
# The gateway resolves the app automatically from the key.
VITE_W24_API_KEY=wtch_your_api_key_here
VITE_W24_GATEWAY_URL=http://localhost:8080

# Optional — only needed for legacy org-level keys that have no app linked.
# VITE_W24_APP_ID=task-tracker-client

# Server-side credentials (can use the same scoped key or a separate one)
W24_API_KEY=wtch_your_api_key_here
W24_GATEWAY_URL=http://localhost:8080

# Optional — only needed for legacy org-level keys.
# W24_APP_ID=task-tracker-server

PORT=3001

# Base URL of the Express server — used by the SDK Test Lab page in the React client.
VITE_W24_SERVER_URL=http://localhost:3001
